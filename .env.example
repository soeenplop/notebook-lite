# notebook-lite environment variables
#
# Local development: copy to `.env` in the repo root. All apps load this file.
# Production: set the variables per app in Dokploy (never commit real values).
# The comment above each block says which app reads it.

# ---------------------------------------------------------------------------
# Supabase (api, worker)
# Local values come from `npx supabase status`.
# ---------------------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
# Publishable (anon) key. The API uses it together with the user's JWT, so RLS applies.
SUPABASE_ANON_KEY=
# Secret (service-role) key. It bypasses RLS: worker (and narrowly scoped api code) only.
# Never expose it to the web app.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (session mode, not the transaction pooler). Used by pg-boss.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---------------------------------------------------------------------------
# Web (Next.js). NEXT_PUBLIC_* values are inlined into the browser bundle.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# API (NestJS)
# ---------------------------------------------------------------------------
API_PORT=4000
# Comma-separated list of allowed browser origins (prod: https://notebook.soeenplop.dev)
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Worker (NestJS)
# ---------------------------------------------------------------------------
# Port for the internal /healthz endpoint (not publicly exposed)
WORKER_PORT=4001

# ---------------------------------------------------------------------------
# OpenAI (api, worker)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6.1-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ---------------------------------------------------------------------------
# ElevenLabs (worker)
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
# Dialogue-capable model for the text-to-dialogue endpoint (confirm in the M5 spike)
ELEVENLABS_MODEL_ID=eleven_v3
# Voice IDs for speaker A (also used for monologues) and speaker B (pending)
ELEVENLABS_VOICE_A=
ELEVENLABS_VOICE_B=

# ---------------------------------------------------------------------------
# Logging (api, worker): trace | debug | info | warn | error
# ---------------------------------------------------------------------------
LOG_LEVEL=info
