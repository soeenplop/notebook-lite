# notebook-lite environment variables
#
# Local development: copy to `.env` in the repo root. All apps load this file.
# There is no local Supabase stack: development uses the remote project
# `notebook-lite` (ref tmwmklntjantjchkhmrg). Keys: `npx supabase projects api-keys`.
# Production: set the variables per app in Dokploy (never commit real values).
# The comment above each block says which app reads it.

# ---------------------------------------------------------------------------
# Supabase (api, worker)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://tmwmklntjantjchkhmrg.supabase.co
# Publishable key (sb_publishable_…). The API uses it together with the user's JWT, so RLS applies.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…). It bypasses RLS: worker (and narrowly scoped api code) only.
# Never expose it to the web app.
SUPABASE_SECRET_KEY=
# Postgres connection for the pg-boss job queue (api, worker): the direct connection or the
# Supavisor *session* pooler (port 5432, IPv4), never the transaction pooler (port 6543).
# pg-boss creates and migrates its own `pgboss` schema on startup.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Web (Next.js). NEXT_PUBLIC_* values are inlined into the browser bundle.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tmwmklntjantjchkhmrg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# API (NestJS)
# ---------------------------------------------------------------------------
API_PORT=4000
# Comma-separated list of allowed browser origins (prod: https://notebook-lite.soeenplop.dev)
CORS_ORIGIN=http://localhost:3000
# Requests per minute and client IP across the whole API (default 300)
RATE_LIMIT_PER_MINUTE=300
# Per-user podcast limits: topic suggestions per hour (default 20) and new podcasts per day
# (default 10). Independently of these, a user can have only one podcast in production at a time.
PODCAST_SUGGESTIONS_PER_HOUR=20
PODCASTS_PER_DAY=10

# ---------------------------------------------------------------------------
# Worker (NestJS)
# ---------------------------------------------------------------------------
# Port for the internal /healthz endpoint (not publicly exposed)
WORKER_PORT=4001

# ---------------------------------------------------------------------------
# OpenAI (api, worker)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6.1-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ---------------------------------------------------------------------------
# ElevenLabs (worker): podcast audio via the text-to-dialogue endpoint.
# Optional at boot: without the key the worker still runs ingestion, and podcast jobs fail
# with "Podcast audio is not configured yet". Voices are fixed per language in
# SUPPORTED_LANGUAGES (packages/shared).
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
# Model for text-to-dialogue (eleven_v3 is the endpoint's default and supports language_code)
ELEVENLABS_MODEL_ID=eleven_v3
# API base URL (default https://api.elevenlabs.io; data-residency hosts also work)
ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# ---------------------------------------------------------------------------
# Logging (api, worker): trace | debug | info | warn | error
# ---------------------------------------------------------------------------
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Deployment tooling (local only, not read by any app; never set in Dokploy)
# Used by the Dokploy CLI (`dokploy …`) and mirrored as GitHub Actions secrets.
# Create the API key in Dokploy: Settings → Profile → API/CLI.
# ---------------------------------------------------------------------------
DOKPLOY_URL=https://dokploy.soeenplop.dev
DOKPLOY_AUTH_TOKEN=
