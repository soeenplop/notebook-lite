{
  "name": "@notebook-lite/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,worker \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --watch dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@notebook-lite/ai": "0.0.0",
    "@notebook-lite/db": "0.0.0",
    "@notebook-lite/queue": "0.0.0",
    "@notebook-lite/shared": "0.0.0",
    "@supabase/supabase-js": "2.119.0",
    "ipaddr.js": "2.5.0",
    "jsdom": "30.1.3",
    "mammoth": "1.13.0",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "turndown": "7.2.4",
    "undici": "8.12.3",
    "unpdf": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.0",
    "@notebook-lite/config": "0.0.0",
    "@types/express": "5.0.6",
    "@types/jsdom": "30.0.0",
    "@types/supertest": "7.2.1",
    "@types/turndown": "5.0.6",
    "ai": "7.0.171",
    "supertest": "7.3.2"
  }
}
